# Database URL (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./smartattend.db
# DATABASE_URL=postgresql://smartattend:smartattend_password@localhost:5432/smartattend_db

# Security (Must be a cryptographically strong random key)
SECRET_KEY=replace-with-a-long-random-secret

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=https://nsit-attendance.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# Server Port
PORT=8000

